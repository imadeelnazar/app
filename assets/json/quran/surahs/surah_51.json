      "surahNumber": 51,
      "ayahNumber": 19,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "وَفِي أَمْوَالِهِمْ حَقٌّ لِّلسَّائِلِ وَالْمَحْرُومِ",
