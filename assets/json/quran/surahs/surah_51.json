      "surahNumber": 51,
      "ayahNumber": 14,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "ذُوقُوا فِتْنَتَكُمْ هَٰذَا الَّذِي كُنتُم بِهِ تَسْتَعْجِلُونَ",
