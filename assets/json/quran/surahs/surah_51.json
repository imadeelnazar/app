    {
      "id": "51_22",
      "surahNumber": 51,
      "ayahNumber": 22,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "وَفِي السَّمَاءِ رِزْقُكُمْ وَمَا تُوعَدُونَ",
