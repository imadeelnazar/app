    {
      "id": "51_21",
      "surahNumber": 51,
      "ayahNumber": 21,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "وَفِي أَنفُسِكُمْ أَفَلَا تُبْصِرُونَ",
