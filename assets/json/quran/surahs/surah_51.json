      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "51_29",
      "surahNumber": 51,
      "ayahNumber": 29,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "فَأَقْبَلَتِ امْرَأَتُهُ فِي صَرَّةٍ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقِيمٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "51_30",
      "surahNumber": 51,
      "ayahNumber": 30,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "قَالُوا كَذَٰلِكِ قَالَ رَبُّكِ إِنَّهُ هُوَ الْحَكِيمُ الْعَلِيمُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "51_31",
      "surahNumber": 51,
      "ayahNumber": 31,
      "juz": 27,
      "hizb": 53,
      "page": 522,
      "textArabic": "قَالَ فَمَا خَطْبُكُمْ أَيُّهَا الْمُرْسَلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "51_32",
      "surahNumber": 51,
      "ayahNumber": 32,
      "juz": 27,
      "hizb": 53,
      "page": 522,
      "textArabic": "قَالُوا إِنَّا أُرْسِلْنَا إِلَىٰ قَوْمٍ مُّجْرِمِينَ",
