      "surahNumber": 51,
      "ayahNumber": 26,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "فَرَاغَ إِلَىٰ أَهْلِهِ فَجَاءَ بِعِجْلٍ سَمِينٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "51_27",
      "surahNumber": 51,
      "ayahNumber": 27,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "فَقَرَّبَهُ إِلَيْهِمْ قَالَ أَلَا تَأْكُلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "51_28",
      "surahNumber": 51,
      "ayahNumber": 28,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "فَأَوْجَسَ مِنْهُمْ خِيفَةً قَالُوا لَا تَخَفْ وَبَشَّرُوهُ بِغُلَامٍ عَلِيمٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
