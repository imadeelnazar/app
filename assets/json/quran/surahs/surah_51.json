      "surahNumber": 51,
      "ayahNumber": 16,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "آخِذِينَ مَا آتَاهُمْ رَبُّهُمْ إِنَّهُمْ كَانُوا قَبْلَ ذَٰلِكَ مُحْسِنِينَ",
