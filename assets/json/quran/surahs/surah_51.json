    },
    {
      "id": "51_20",
      "surahNumber": 51,
      "ayahNumber": 20,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "وَفِي الْأَرْضِ آيَاتٌ لِّلْمُوقِنِينَ",
