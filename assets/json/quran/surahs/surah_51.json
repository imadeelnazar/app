      "surahNumber": 51,
      "ayahNumber": 25,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "إِذْ دَخَلُوا عَلَيْهِ فَقَالُوا سَلَامًا قَالَ سَلَامٌ قَوْمٌ مُّنكَرُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
