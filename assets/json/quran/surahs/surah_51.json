    },
    {
      "id": "51_18",
      "surahNumber": 51,
      "ayahNumber": 18,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "وَبِالْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ",
      "textEnglish": "",
      "textUrdu": "",
