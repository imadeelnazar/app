      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "51_24",
      "surahNumber": 51,
      "ayahNumber": 24,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "هَلْ أَتَاكَ حَدِيثُ ضَيْفِ إِبْرَاهِيمَ الْمُكْرَمِينَ",
      "textEnglish": "",
