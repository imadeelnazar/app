      "surahNumber": 51,
      "ayahNumber": 17,
      "juz": 26,
      "hizb": 52,
      "page": 521,
      "textArabic": "كَانُوا قَلِيلًا مِّنَ اللَّيْلِ مَا يَهْجَعُونَ",
