      "surahNumber": 21,
      "ayahNumber": 15,
      "juz": 17,
      "hizb": 33,
      "page": 323,
      "textArabic": "فَمَا زَالَت تِّلْكَ دَعْوَاهُمْ حَتَّىٰ جَعَلْنَاهُمْ حَصِيدًا خَامِدِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
