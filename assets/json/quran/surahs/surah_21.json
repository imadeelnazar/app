      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "21_16",
      "surahNumber": 21,
      "ayahNumber": 16,
      "juz": 17,
      "hizb": 33,
      "page": 323,
      "textArabic": "وَمَا خَلَقْنَا السَّمَاءَ وَالْأَرْضَ وَمَا بَيْنَهُمَا لَاعِبِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
