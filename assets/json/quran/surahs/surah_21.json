      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "21_14",
      "surahNumber": 21,
      "ayahNumber": 14,
      "juz": 17,
      "hizb": 33,
      "page": 323,
      "textArabic": "قَالُوا يَا وَيْلَنَا إِنَّا كُنَّا ظَالِمِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
