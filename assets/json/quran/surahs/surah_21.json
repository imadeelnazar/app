      "surahNumber": 21,
      "ayahNumber": 23,
      "juz": 17,
      "hizb": 33,
      "page": 323,
      "textArabic": "لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
