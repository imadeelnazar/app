      "surahNumber": 21,
      "ayahNumber": 32,
      "juz": 17,
      "hizb": 33,
      "page": 324,
      "textArabic": "وَجَعَلْنَا السَّمَاءَ سَقْفًا مَّحْفُوظًا وَهُمْ عَنْ آيَاتِهَا مُعْرِضُونَ",
