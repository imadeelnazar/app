    },
    {
      "id": "21_21",
      "surahNumber": 21,
      "ayahNumber": 21,
      "juz": 17,
      "hizb": 33,
      "page": 323,
      "textArabic": "أَمِ اتَّخَذُوا آلِهَةً مِّنَ الْأَرْضِ هُمْ يُنشِرُونَ",
