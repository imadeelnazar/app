      "surahNumber": 54,
      "ayahNumber": 28,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "وَنَبِّئْهُمْ أَنَّ الْمَاءَ قِسْمَةٌ بَيْنَهُمْ كُلُّ شِرْبٍ مُّحْتَضَرٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_29",
      "surahNumber": 54,
      "ayahNumber": 29,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "فَنَادَوْا صَاحِبَهُمْ فَتَعَاطَىٰ فَعَقَرَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_30",
      "surahNumber": 54,
      "ayahNumber": 30,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "فَكَيْفَ كَانَ عَذَابِي وَنُذُرِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_31",
      "surahNumber": 54,
      "ayahNumber": 31,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "إِنَّا أَرْسَلْنَا عَلَيْهِمْ صَيْحَةً وَاحِدَةً فَكَانُوا كَهَشِيمِ الْمُحْتَظِرِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_32",
      "surahNumber": 54,
      "ayahNumber": 32,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "وَلَقَدْ يَسَّرْنَا الْقُرْآنَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_33",
      "surahNumber": 54,
      "ayahNumber": 33,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "كَذَّبَتْ قَوْمُ لُوطٍ بِالنُّذُرِ",
