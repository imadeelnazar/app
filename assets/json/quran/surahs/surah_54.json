      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_36",
      "surahNumber": 54,
      "ayahNumber": 36,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "وَلَقَدْ أَنذَرَهُم بَطْشَتَنَا فَتَمَارَوْا بِالنُّذُرِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
