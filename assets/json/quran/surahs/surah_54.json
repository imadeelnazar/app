      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_37",
      "surahNumber": 54,
      "ayahNumber": 37,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "وَلَقَدْ رَاوَدُوهُ عَن ضَيْفِهِ فَطَمَسْنَا أَعْيُنَهُمْ فَذُوقُوا عَذَابِي وَنُذُرِ",
