  "ayahs": [
    {
      "id": "54_1",
      "surahNumber": 54,
      "ayahNumber": 1,
      "juz": 27,
      "hizb": 53,
      "page": 528,
      "textArabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اقْتَرَبَتِ السَّاعَةُ وَانشَقَّ الْقَمَرُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_2",
      "surahNumber": 54,
      "ayahNumber": 2,
      "juz": 27,
      "hizb": 53,
      "page": 528,
      "textArabic": "وَإِن يَرَوْا آيَةً يُعْرِضُوا وَيَقُولُوا سِحْرٌ مُّسْتَمِرٌّ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_3",
      "surahNumber": 54,
      "ayahNumber": 3,
      "juz": 27,
      "hizb": 53,
      "page": 528,
      "textArabic": "وَكَذَّبُوا وَاتَّبَعُوا أَهْوَاءَهُمْ وَكُلُّ أَمْرٍ مُّسْتَقِرٌّ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_4",
      "surahNumber": 54,
      "ayahNumber": 4,
      "juz": 27,
      "hizb": 53,
      "page": 528,
      "textArabic": "وَلَقَدْ جَاءَهُم مِّنَ الْأَنبَاءِ مَا فِيهِ مُزْدَجَرٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_5",
      "surahNumber": 54,
      "ayahNumber": 5,
      "juz": 27,
      "hizb": 53,
      "page": 528,
      "textArabic": "حِكْمَةٌ بَالِغَةٌ فَمَا تُغْنِ النُّذُرُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_6",
      "surahNumber": 54,
      "ayahNumber": 6,
      "juz": 27,
      "hizb": 53,
      "page": 528,
      "textArabic": "فَتَوَلَّ عَنْهُمْ يَوْمَ يَدْعُ الدَّاعِ إِلَىٰ شَيْءٍ نُّكُرٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_7",
      "surahNumber": 54,
      "ayahNumber": 7,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "خُشَّعًا أَبْصَارُهُمْ يَخْرُجُونَ مِنَ الْأَجْدَاثِ كَأَنَّهُمْ جَرَادٌ مُّنتَشِرٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_8",
      "surahNumber": 54,
      "ayahNumber": 8,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "مُّهْطِعِينَ إِلَى الدَّاعِ يَقُولُ الْكَافِرُونَ هَٰذَا يَوْمٌ عَسِرٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_9",
      "surahNumber": 54,
      "ayahNumber": 9,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ فَكَذَّبُوا عَبْدَنَا وَقَالُوا مَجْنُونٌ وَازْدُجِرَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_10",
      "surahNumber": 54,
      "ayahNumber": 10,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "فَدَعَا رَبَّهُ أَنِّي مَغْلُوبٌ فَانتَصِرْ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_11",
      "surahNumber": 54,
      "ayahNumber": 11,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "فَفَتَحْنَا أَبْوَابَ السَّمَاءِ بِمَاءٍ مُّنْهَمِرٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_12",
      "surahNumber": 54,
      "ayahNumber": 12,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "وَفَجَّرْنَا الْأَرْضَ عُيُونًا فَالْتَقَى الْمَاءُ عَلَىٰ أَمْرٍ قَدْ قُدِرَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_13",
      "surahNumber": 54,
      "ayahNumber": 13,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "وَحَمَلْنَاهُ عَلَىٰ ذَاتِ أَلْوَاحٍ وَدُسُرٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_14",
      "surahNumber": 54,
      "ayahNumber": 14,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "تَجْرِي بِأَعْيُنِنَا جَزَاءً لِّمَن كَانَ كُفِرَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_15",
      "surahNumber": 54,
      "ayahNumber": 15,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "وَلَقَد تَّرَكْنَاهَا آيَةً فَهَلْ مِن مُّدَّكِرٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_16",
      "surahNumber": 54,
      "ayahNumber": 16,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "فَكَيْفَ كَانَ عَذَابِي وَنُذُرِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_17",
      "surahNumber": 54,
      "ayahNumber": 17,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "وَلَقَدْ يَسَّرْنَا الْقُرْآنَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_18",
      "surahNumber": 54,
      "ayahNumber": 18,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "كَذَّبَتْ عَادٌ فَكَيْفَ كَانَ عَذَابِي وَنُذُرِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
