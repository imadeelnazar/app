    {
      "id": "54_23",
      "surahNumber": 54,
      "ayahNumber": 23,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "كَذَّبَتْ ثَمُودُ بِالنُّذُرِ",
