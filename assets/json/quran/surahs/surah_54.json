      "surahNumber": 54,
      "ayahNumber": 20,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "تَنزِعُ النَّاسَ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ مُّنقَعِرٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_21",
      "surahNumber": 54,
      "ayahNumber": 21,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "فَكَيْفَ كَانَ عَذَابِي وَنُذُرِ",
