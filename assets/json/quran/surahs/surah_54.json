      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "54_35",
      "surahNumber": 54,
      "ayahNumber": 35,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "نِّعْمَةً مِّنْ عِندِنَا كَذَٰلِكَ نَجْزِي مَن شَكَرَ",
