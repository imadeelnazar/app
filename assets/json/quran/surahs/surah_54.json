      "surahNumber": 54,
      "ayahNumber": 41,
      "juz": 27,
      "hizb": 53,
      "page": 530,
      "textArabic": "وَلَقَدْ جَاءَ آلَ فِرْعَوْنَ النُّذُرُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
