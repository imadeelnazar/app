    {
      "id": "54_25",
      "surahNumber": 54,
      "ayahNumber": 25,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "أَأُلْقِيَ الذِّكْرُ عَلَيْهِ مِن بَيْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌ",
