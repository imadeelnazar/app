      "surahNumber": 54,
      "ayahNumber": 26,
      "juz": 27,
      "hizb": 53,
      "page": 529,
      "textArabic": "سَيَعْلَمُونَ غَدًا مَّنِ الْكَذَّابُ الْأَشِرُ",
