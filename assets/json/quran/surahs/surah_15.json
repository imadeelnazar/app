      "surahNumber": 15,
      "ayahNumber": 60,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "إِلَّا امْرَأَتَهُ قَدَّرْنَا إِنَّهَا لَمِنَ الْغَابِرِينَ",
