      "surahNumber": 15,
      "ayahNumber": 71,
      "juz": 14,
      "hizb": 27,
      "page": 266,
      "textArabic": "قَالَ هَٰؤُلَاءِ بَنَاتِي إِن كُنتُمْ فَاعِلِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
