      "surahNumber": 15,
      "ayahNumber": 72,
      "juz": 14,
      "hizb": 27,
      "page": 266,
      "textArabic": "لَعَمْرُكَ إِنَّهُمْ لَفِي سَكْرَتِهِمْ يَعْمَهُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_73",
      "surahNumber": 15,
      "ayahNumber": 73,
      "juz": 14,
      "hizb": 27,
      "page": 266,
      "textArabic": "فَأَخَذَتْهُمُ الصَّيْحَةُ مُشْرِقِينَ",
