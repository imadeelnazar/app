      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_38",
      "surahNumber": 15,
      "ayahNumber": 38,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "إِلَىٰ يَوْمِ الْوَقْتِ الْمَعْلُومِ",
