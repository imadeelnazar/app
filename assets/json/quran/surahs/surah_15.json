      "surahNumber": 15,
      "ayahNumber": 47,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "وَنَزَعْنَا مَا فِي صُدُورِهِم مِّنْ غِلٍّ إِخْوَانًا عَلَىٰ سُرُرٍ مُّتَقَابِلِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_48",
      "surahNumber": 15,
      "ayahNumber": 48,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُم مِّنْهَا بِمُخْرَجِينَ",
