      "surahNumber": 15,
      "ayahNumber": 77,
      "juz": 14,
      "hizb": 27,
      "page": 266,
      "textArabic": "إِنَّ فِي ذَٰلِكَ لَآيَةً لِّلْمُؤْمِنِينَ",
