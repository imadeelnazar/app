      "surahNumber": 15,
      "ayahNumber": 43,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ أَجْمَعِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_44",
      "surahNumber": 15,
      "ayahNumber": 44,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "لَهَا سَبْعَةُ أَبْوَابٍ لِّكُلِّ بَابٍ مِّنْهُمْ جُزْءٌ مَّقْسُومٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_45",
      "surahNumber": 15,
      "ayahNumber": 45,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَعُيُونٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_46",
      "surahNumber": 15,
      "ayahNumber": 46,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "ادْخُلُوهَا بِسَلَامٍ آمِنِينَ",
