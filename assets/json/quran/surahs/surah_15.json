      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_41",
      "surahNumber": 15,
      "ayahNumber": 41,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "قَالَ هَٰذَا صِرَاطٌ عَلَيَّ مُسْتَقِيمٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
