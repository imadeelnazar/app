      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_62",
      "surahNumber": 15,
      "ayahNumber": 62,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "قَالَ إِنَّكُمْ قَوْمٌ مُّنكَرُونَ",
