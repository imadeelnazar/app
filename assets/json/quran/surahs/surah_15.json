      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_67",
      "surahNumber": 15,
      "ayahNumber": 67,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "وَجَاءَ أَهْلُ الْمَدِينَةِ يَسْتَبْشِرُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_68",
      "surahNumber": 15,
      "ayahNumber": 68,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "قَالَ إِنَّ هَٰؤُلَاءِ ضَيْفِي فَلَا تَفْضَحُونِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_69",
      "surahNumber": 15,
      "ayahNumber": 69,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "وَاتَّقُوا اللَّهَ وَلَا تُخْزُونِ",
