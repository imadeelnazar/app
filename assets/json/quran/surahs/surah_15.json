      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_40",
      "surahNumber": 15,
      "ayahNumber": 40,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "إِلَّا عِبَادَكَ مِنْهُمُ الْمُخْلَصِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
