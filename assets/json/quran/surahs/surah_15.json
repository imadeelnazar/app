      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_70",
      "surahNumber": 15,
      "ayahNumber": 70,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "قَالُوا أَوَلَمْ نَنْهَكَ عَنِ الْعَالَمِينَ",
