      "surahNumber": 15,
      "ayahNumber": 75,
      "juz": 14,
      "hizb": 27,
      "page": 266,
      "textArabic": "إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِّلْمُتَوَسِّمِينَ",
