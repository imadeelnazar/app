  "ayahs": [
    {
      "id": "15_1",
      "surahNumber": 15,
      "ayahNumber": 1,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الر تِلْكَ آيَاتُ الْكِتَابِ وَقُرْآنٍ مُّبِينٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_2",
      "surahNumber": 15,
      "ayahNumber": 2,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "رُّبَمَا يَوَدُّ الَّذِينَ كَفَرُوا لَوْ كَانُوا مُسْلِمِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_3",
      "surahNumber": 15,
      "ayahNumber": 3,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "ذَرْهُمْ يَأْكُلُوا وَيَتَمَتَّعُوا وَيُلْهِهِمُ الْأَمَلُ فَسَوْفَ يَعْلَمُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_4",
      "surahNumber": 15,
      "ayahNumber": 4,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "وَمَا أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا وَلَهَا كِتَابٌ مَّعْلُومٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_5",
      "surahNumber": 15,
      "ayahNumber": 5,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "مَّا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَأْخِرُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_6",
      "surahNumber": 15,
      "ayahNumber": 6,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "وَقَالُوا يَا أَيُّهَا الَّذِي نُزِّلَ عَلَيْهِ الذِّكْرُ إِنَّكَ لَمَجْنُونٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_7",
      "surahNumber": 15,
      "ayahNumber": 7,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "لَّوْ مَا تَأْتِينَا بِالْمَلَائِكَةِ إِن كُنتَ مِنَ الصَّادِقِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_8",
      "surahNumber": 15,
      "ayahNumber": 8,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "مَا نُنَزِّلُ الْمَلَائِكَةَ إِلَّا بِالْحَقِّ وَمَا كَانُوا إِذًا مُّنظَرِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_9",
      "surahNumber": 15,
      "ayahNumber": 9,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_10",
      "surahNumber": 15,
      "ayahNumber": 10,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ فِي شِيَعِ الْأَوَّلِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_11",
      "surahNumber": 15,
      "ayahNumber": 11,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "وَمَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_12",
      "surahNumber": 15,
      "ayahNumber": 12,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "كَذَٰلِكَ نَسْلُكُهُ فِي قُلُوبِ الْمُجْرِمِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_13",
      "surahNumber": 15,
      "ayahNumber": 13,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "لَا يُؤْمِنُونَ بِهِ وَقَدْ خَلَتْ سُنَّةُ الْأَوَّلِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_14",
      "surahNumber": 15,
      "ayahNumber": 14,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "وَلَوْ فَتَحْنَا عَلَيْهِم بَابًا مِّنَ السَّمَاءِ فَظَلُّوا فِيهِ يَعْرُجُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_15",
      "surahNumber": 15,
      "ayahNumber": 15,
      "juz": 14,
      "hizb": 27,
      "page": 262,
      "textArabic": "لَقَالُوا إِنَّمَا سُكِّرَتْ أَبْصَارُنَا بَلْ نَحْنُ قَوْمٌ مَّسْحُورُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_16",
      "surahNumber": 15,
      "ayahNumber": 16,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَلَقَدْ جَعَلْنَا فِي السَّمَاءِ بُرُوجًا وَزَيَّنَّاهَا لِلنَّاظِرِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_17",
      "surahNumber": 15,
      "ayahNumber": 17,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَحَفِظْنَاهَا مِن كُلِّ شَيْطَانٍ رَّجِيمٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_18",
      "surahNumber": 15,
      "ayahNumber": 18,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "إِلَّا مَنِ اسْتَرَقَ السَّمْعَ فَأَتْبَعَهُ شِهَابٌ مُّبِينٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_19",
      "surahNumber": 15,
      "ayahNumber": 19,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَالْأَرْضَ مَدَدْنَاهَا وَأَلْقَيْنَا فِيهَا رَوَاسِيَ وَأَنبَتْنَا فِيهَا مِن كُلِّ شَيْءٍ مَّوْزُونٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_20",
      "surahNumber": 15,
      "ayahNumber": 20,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَجَعَلْنَا لَكُمْ فِيهَا مَعَايِشَ وَمَن لَّسْتُمْ لَهُ بِرَازِقِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_21",
      "surahNumber": 15,
      "ayahNumber": 21,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَإِن مِّن شَيْءٍ إِلَّا عِندَنَا خَزَائِنُهُ وَمَا نُنَزِّلُهُ إِلَّا بِقَدَرٍ مَّعْلُومٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_22",
      "surahNumber": 15,
      "ayahNumber": 22,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَأَرْسَلْنَا الرِّيَاحَ لَوَاقِحَ فَأَنزَلْنَا مِنَ السَّمَاءِ مَاءً فَأَسْقَيْنَاكُمُوهُ وَمَا أَنتُمْ لَهُ بِخَازِنِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_23",
      "surahNumber": 15,
      "ayahNumber": 23,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَإِنَّا لَنَحْنُ نُحْيِي وَنُمِيتُ وَنَحْنُ الْوَارِثُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_24",
      "surahNumber": 15,
      "ayahNumber": 24,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَلَقَدْ عَلِمْنَا الْمُسْتَقْدِمِينَ مِنكُمْ وَلَقَدْ عَلِمْنَا الْمُسْتَأْخِرِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_25",
      "surahNumber": 15,
      "ayahNumber": 25,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَإِنَّ رَبَّكَ هُوَ يَحْشُرُهُمْ إِنَّهُ حَكِيمٌ عَلِيمٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_26",
      "surahNumber": 15,
      "ayahNumber": 26,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَلَقَدْ خَلَقْنَا الْإِنسَانَ مِن صَلْصَالٍ مِّنْ حَمَإٍ مَّسْنُونٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_27",
      "surahNumber": 15,
      "ayahNumber": 27,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَالْجَانَّ خَلَقْنَاهُ مِن قَبْلُ مِن نَّارِ السَّمُومِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_28",
      "surahNumber": 15,
      "ayahNumber": 28,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِّن صَلْصَالٍ مِّنْ حَمَإٍ مَّسْنُونٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_29",
      "surahNumber": 15,
      "ayahNumber": 29,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "فَإِذَا سَوَّيْتُهُ وَنَفَخْتُ فِيهِ مِن رُّوحِي فَقَعُوا لَهُ سَاجِدِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_30",
      "surahNumber": 15,
      "ayahNumber": 30,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "فَسَجَدَ الْمَلَائِكَةُ كُلُّهُمْ أَجْمَعُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_31",
      "surahNumber": 15,
      "ayahNumber": 31,
      "juz": 14,
      "hizb": 27,
      "page": 263,
      "textArabic": "إِلَّا إِبْلِيسَ أَبَىٰ أَن يَكُونَ مَعَ السَّاجِدِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_32",
      "surahNumber": 15,
      "ayahNumber": 32,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "قَالَ يَا إِبْلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ السَّاجِدِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_33",
      "surahNumber": 15,
      "ayahNumber": 33,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "قَالَ لَمْ أَكُن لِّأَسْجُدَ لِبَشَرٍ خَلَقْتَهُ مِن صَلْصَالٍ مِّنْ حَمَإٍ مَّسْنُونٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_34",
      "surahNumber": 15,
      "ayahNumber": 34,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "قَالَ فَاخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_35",
      "surahNumber": 15,
      "ayahNumber": 35,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "وَإِنَّ عَلَيْكَ اللَّعْنَةَ إِلَىٰ يَوْمِ الدِّينِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_36",
      "surahNumber": 15,
      "ayahNumber": 36,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "قَالَ رَبِّ فَأَنظِرْنِي إِلَىٰ يَوْمِ يُبْعَثُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_37",
      "surahNumber": 15,
      "ayahNumber": 37,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "قَالَ فَإِنَّكَ مِنَ الْمُنظَرِينَ",
