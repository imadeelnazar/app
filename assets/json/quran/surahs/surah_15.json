      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_49",
      "surahNumber": 15,
      "ayahNumber": 49,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_50",
      "surahNumber": 15,
      "ayahNumber": 50,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "وَأَنَّ عَذَابِي هُوَ الْعَذَابُ الْأَلِيمُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_51",
      "surahNumber": 15,
      "ayahNumber": 51,
      "juz": 14,
      "hizb": 27,
      "page": 264,
      "textArabic": "وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَاهِيمَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_52",
      "surahNumber": 15,
      "ayahNumber": 52,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "إِذْ دَخَلُوا عَلَيْهِ فَقَالُوا سَلَامًا قَالَ إِنَّا مِنكُمْ وَجِلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_53",
      "surahNumber": 15,
      "ayahNumber": 53,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "قَالُوا لَا تَوْجَلْ إِنَّا نُبَشِّرُكَ بِغُلَامٍ عَلِيمٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_54",
      "surahNumber": 15,
      "ayahNumber": 54,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "قَالَ أَبَشَّرْتُمُونِي عَلَىٰ أَن مَّسَّنِيَ الْكِبَرُ فَبِمَ تُبَشِّرُونَ",
