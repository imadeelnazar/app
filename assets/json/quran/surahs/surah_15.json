      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_55",
      "surahNumber": 15,
      "ayahNumber": 55,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "قَالُوا بَشَّرْنَاكَ بِالْحَقِّ فَلَا تَكُن مِّنَ الْقَانِطِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "15_56",
      "surahNumber": 15,
      "ayahNumber": 56,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "قَالَ وَمَن يَقْنَطُ مِن رَّحْمَةِ رَبِّهِ إِلَّا الضَّالُّونَ",
