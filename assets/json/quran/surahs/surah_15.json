      "surahNumber": 15,
      "ayahNumber": 57,
      "juz": 14,
      "hizb": 27,
      "page": 265,
      "textArabic": "قَالَ فَمَا خَطْبُكُمْ أَيُّهَا الْمُرْسَلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
