  "ayahs": [
    {
      "id": "71_1",
      "surahNumber": 71,
      "ayahNumber": 1,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِنَّا أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِ أَنْ أَنذِرْ قَوْمَكَ مِن قَبْلِ أَن يَأْتِيَهُمْ عَذَابٌ أَلِيمٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_2",
      "surahNumber": 71,
      "ayahNumber": 2,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "قَالَ يَا قَوْمِ إِنِّي لَكُمْ نَذِيرٌ مُّبِينٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_3",
      "surahNumber": 71,
      "ayahNumber": 3,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "أَنِ اعْبُدُوا اللَّهَ وَاتَّقُوهُ وَأَطِيعُونِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_4",
      "surahNumber": 71,
      "ayahNumber": 4,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَىٰ أَجَلٍ مُّسَمًّى إِنَّ أَجَلَ اللَّهِ إِذَا جَاءَ لَا يُؤَخَّرُ لَوْ كُنتُمْ تَعْلَمُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_5",
      "surahNumber": 71,
      "ayahNumber": 5,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "قَالَ رَبِّ إِنِّي دَعَوْتُ قَوْمِي لَيْلًا وَنَهَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_6",
      "surahNumber": 71,
      "ayahNumber": 6,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "فَلَمْ يَزِدْهُمْ دُعَائِي إِلَّا فِرَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_7",
      "surahNumber": 71,
      "ayahNumber": 7,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "وَإِنِّي كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَلُوا أَصَابِعَهُمْ فِي آذَانِهِمْ وَاسْتَغْشَوْا ثِيَابَهُمْ وَأَصَرُّوا وَاسْتَكْبَرُوا اسْتِكْبَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_8",
      "surahNumber": 71,
      "ayahNumber": 8,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "ثُمَّ إِنِّي دَعَوْتُهُمْ جِهَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_9",
      "surahNumber": 71,
      "ayahNumber": 9,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "ثُمَّ إِنِّي أَعْلَنتُ لَهُمْ وَأَسْرَرْتُ لَهُمْ إِسْرَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_10",
      "surahNumber": 71,
      "ayahNumber": 10,
      "juz": 29,
      "hizb": 57,
      "page": 570,
      "textArabic": "فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_11",
      "surahNumber": 71,
      "ayahNumber": 11,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "يُرْسِلِ السَّمَاءَ عَلَيْكُم مِّدْرَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_12",
      "surahNumber": 71,
      "ayahNumber": 12,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَيُمْدِدْكُم بِأَمْوَالٍ وَبَنِينَ وَيَجْعَل لَّكُمْ جَنَّاتٍ وَيَجْعَل لَّكُمْ أَنْهَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_13",
      "surahNumber": 71,
      "ayahNumber": 13,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_14",
      "surahNumber": 71,
      "ayahNumber": 14,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَقَدْ خَلَقَكُمْ أَطْوَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_15",
      "surahNumber": 71,
      "ayahNumber": 15,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_16",
      "surahNumber": 71,
      "ayahNumber": 16,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_17",
      "surahNumber": 71,
      "ayahNumber": 17,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_18",
      "surahNumber": 71,
      "ayahNumber": 18,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_19",
      "surahNumber": 71,
      "ayahNumber": 19,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَاللَّهُ جَعَلَ لَكُمُ الْأَرْضَ بِسَاطًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_20",
      "surahNumber": 71,
      "ayahNumber": 20,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "لِّتَسْلُكُوا مِنْهَا سُبُلًا فِجَاجًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_21",
      "surahNumber": 71,
      "ayahNumber": 21,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "قَالَ نُوحٌ رَّبِّ إِنَّهُمْ عَصَوْنِي وَاتَّبَعُوا مَن لَّمْ يَزِدْهُ مَالُهُ وَوَلَدُهُ إِلَّا خَسَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_22",
      "surahNumber": 71,
      "ayahNumber": 22,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَمَكَرُوا مَكْرًا كُبَّارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_23",
      "surahNumber": 71,
      "ayahNumber": 23,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَقَالُوا لَا تَذَرُنَّ آلِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّا وَلَا سُوَاعًا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_24",
      "surahNumber": 71,
      "ayahNumber": 24,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَقَدْ أَضَلُّوا كَثِيرًا وَلَا تَزِدِ الظَّالِمِينَ إِلَّا ضَلَالًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_25",
      "surahNumber": 71,
      "ayahNumber": 25,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "مِّمَّا خَطِيئَاتِهِمْ أُغْرِقُوا فَأُدْخِلُوا نَارًا فَلَمْ يَجِدُوا لَهُم مِّن دُونِ اللَّهِ أَنصَارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_26",
      "surahNumber": 71,
      "ayahNumber": 26,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "وَقَالَ نُوحٌ رَّبِّ لَا تَذَرْ عَلَى الْأَرْضِ مِنَ الْكَافِرِينَ دَيَّارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_27",
      "surahNumber": 71,
      "ayahNumber": 27,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "إِنَّكَ إِن تَذَرْهُمْ يُضِلُّوا عِبَادَكَ وَلَا يَلِدُوا إِلَّا فَاجِرًا كَفَّارًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "71_28",
      "surahNumber": 71,
      "ayahNumber": 28,
      "juz": 29,
      "hizb": 57,
      "page": 571,
      "textArabic": "رَّبِّ اغْفِرْ لِي وَلِوَالِدَيَّ وَلِمَن دَخَلَ بَيْتِيَ مُؤْمِنًا وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَلَا تَزِدِ الظَّالِمِينَ إِلَّا تَبَارًا",
