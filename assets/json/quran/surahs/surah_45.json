    {
      "id": "45_3",
      "surahNumber": 45,
      "ayahNumber": 3,
      "juz": 25,
      "hizb": 50,
      "page": 499,
      "textArabic": "إِنَّ فِي السَّمَاوَاتِ وَالْأَرْضِ لَآيَاتٍ لِّلْمُؤْمِنِينَ",
