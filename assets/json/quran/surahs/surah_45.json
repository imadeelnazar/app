    },
    {
      "id": "45_4",
      "surahNumber": 45,
      "ayahNumber": 4,
      "juz": 25,
      "hizb": 50,
      "page": 499,
      "textArabic": "وَفِي خَلْقِكُمْ وَمَا يَبُثُّ مِن دَابَّةٍ آيَاتٌ لِّقَوْمٍ يُوقِنُونَ",
