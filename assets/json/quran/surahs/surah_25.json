      "surahNumber": 25,
      "ayahNumber": 33,
      "juz": 19,
      "hizb": 37,
      "page": 363,
      "textArabic": "وَلَا يَأْتُونَكَ بِمَثَلٍ إِلَّا جِئْنَاكَ بِالْحَقِّ وَأَحْسَنَ تَفْسِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
