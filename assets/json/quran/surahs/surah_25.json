      "surahNumber": 25,
      "ayahNumber": 34,
      "juz": 19,
      "hizb": 37,
      "page": 363,
      "textArabic": "الَّذِينَ يُحْشَرُونَ عَلَىٰ وُجُوهِهِمْ إِلَىٰ جَهَنَّمَ أُولَٰئِكَ شَرٌّ مَّكَانًا وَأَضَلُّ سَبِيلًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_35",
      "surahNumber": 25,
      "ayahNumber": 35,
      "juz": 19,
      "hizb": 37,
      "page": 363,
      "textArabic": "وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ وَجَعَلْنَا مَعَهُ أَخَاهُ هَارُونَ وَزِيرًا",
