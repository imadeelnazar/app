      "surahNumber": 25,
      "ayahNumber": 49,
      "juz": 19,
      "hizb": 37,
      "page": 364,
      "textArabic": "لِّنُحْيِيَ بِهِ بَلْدَةً مَّيْتًا وَنُسْقِيَهُ مِمَّا خَلَقْنَا أَنْعَامًا وَأَنَاسِيَّ كَثِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_50",
      "surahNumber": 25,
      "ayahNumber": 50,
      "juz": 19,
      "hizb": 37,
      "page": 364,
      "textArabic": "وَلَقَدْ صَرَّفْنَاهُ بَيْنَهُمْ لِيَذَّكَّرُوا فَأَبَىٰ أَكْثَرُ النَّاسِ إِلَّا كُفُورًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_51",
      "surahNumber": 25,
      "ayahNumber": 51,
      "juz": 19,
      "hizb": 37,
      "page": 364,
      "textArabic": "وَلَوْ شِئْنَا لَبَعَثْنَا فِي كُلِّ قَرْيَةٍ نَّذِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_52",
      "surahNumber": 25,
      "ayahNumber": 52,
      "juz": 19,
      "hizb": 37,
      "page": 364,
      "textArabic": "فَلَا تُطِعِ الْكَافِرِينَ وَجَاهِدْهُم بِهِ جِهَادًا كَبِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_53",
      "surahNumber": 25,
      "ayahNumber": 53,
      "juz": 19,
      "hizb": 37,
      "page": 364,
      "textArabic": "وَهُوَ الَّذِي مَرَجَ الْبَحْرَيْنِ هَٰذَا عَذْبٌ فُرَاتٌ وَهَٰذَا مِلْحٌ أُجَاجٌ وَجَعَلَ بَيْنَهُمَا بَرْزَخًا وَحِجْرًا مَّحْجُورًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_54",
      "surahNumber": 25,
      "ayahNumber": 54,
      "juz": 19,
      "hizb": 37,
      "page": 364,
      "textArabic": "وَهُوَ الَّذِي خَلَقَ مِنَ الْمَاءِ بَشَرًا فَجَعَلَهُ نَسَبًا وَصِهْرًا وَكَانَ رَبُّكَ قَدِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_55",
      "surahNumber": 25,
      "ayahNumber": 55,
      "juz": 19,
      "hizb": 37,
      "page": 364,
      "textArabic": "وَيَعْبُدُونَ مِن دُونِ اللَّهِ مَا لَا يَنفَعُهُمْ وَلَا يَضُرُّهُمْ وَكَانَ الْكَافِرُ عَلَىٰ رَبِّهِ ظَهِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_56",
      "surahNumber": 25,
      "ayahNumber": 56,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "وَمَا أَرْسَلْنَاكَ إِلَّا مُبَشِّرًا وَنَذِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_57",
      "surahNumber": 25,
      "ayahNumber": 57,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "قُلْ مَا أَسْأَلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِلَّا مَن شَاءَ أَن يَتَّخِذَ إِلَىٰ رَبِّهِ سَبِيلًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_58",
      "surahNumber": 25,
      "ayahNumber": 58,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "وَتَوَكَّلْ عَلَى الْحَيِّ الَّذِي لَا يَمُوتُ وَسَبِّحْ بِحَمْدِهِ وَكَفَىٰ بِهِ بِذُنُوبِ عِبَادِهِ خَبِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_59",
      "surahNumber": 25,
      "ayahNumber": 59,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ الرَّحْمَٰنُ فَاسْأَلْ بِهِ خَبِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_60",
      "surahNumber": 25,
      "ayahNumber": 60,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "وَإِذَا قِيلَ لَهُمُ اسْجُدُوا لِلرَّحْمَٰنِ قَالُوا وَمَا الرَّحْمَٰنُ أَنَسْجُدُ لِمَا تَأْمُرُنَا وَزَادَهُمْ نُفُورًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_61",
      "surahNumber": 25,
      "ayahNumber": 61,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "تَبَارَكَ الَّذِي جَعَلَ فِي السَّمَاءِ بُرُوجًا وَجَعَلَ فِيهَا سِرَاجًا وَقَمَرًا مُّنِيرًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_62",
      "surahNumber": 25,
      "ayahNumber": 62,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "وَهُوَ الَّذِي جَعَلَ اللَّيْلَ وَالنَّهَارَ خِلْفَةً لِّمَنْ أَرَادَ أَن يَذَّكَّرَ أَوْ أَرَادَ شُكُورًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_63",
      "surahNumber": 25,
      "ayahNumber": 63,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "وَعِبَادُ الرَّحْمَٰنِ الَّذِينَ يَمْشُونَ عَلَى الْأَرْضِ هَوْنًا وَإِذَا خَاطَبَهُمُ الْجَاهِلُونَ قَالُوا سَلَامًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_64",
      "surahNumber": 25,
      "ayahNumber": 64,
      "juz": 19,
      "hizb": 37,
      "page": 365,
      "textArabic": "وَالَّذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّدًا وَقِيَامًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "25_65",
      "surahNumber": 25,
      "ayahNumber": 65,
      "juz": 19,
      "hizb": 37,
      "page": 365,
