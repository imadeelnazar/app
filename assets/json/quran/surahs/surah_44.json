      "surahNumber": 44,
      "ayahNumber": 2,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "وَالْكِتَابِ الْمُبِينِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_3",
      "surahNumber": 44,
      "ayahNumber": 3,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "إِنَّا أَنزَلْنَاهُ فِي لَيْلَةٍ مُّبَارَكَةٍ إِنَّا كُنَّا مُنذِرِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_4",
      "surahNumber": 44,
      "ayahNumber": 4,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_5",
      "surahNumber": 44,
      "ayahNumber": 5,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "أَمْرًا مِّنْ عِندِنَا إِنَّا كُنَّا مُرْسِلِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_6",
      "surahNumber": 44,
      "ayahNumber": 6,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "رَحْمَةً مِّن رَّبِّكَ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_7",
      "surahNumber": 44,
      "ayahNumber": 7,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا إِن كُنتُم مُّوقِنِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_8",
      "surahNumber": 44,
      "ayahNumber": 8,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "لَا إِلَٰهَ إِلَّا هُوَ يُحْيِي وَيُمِيتُ رَبُّكُمْ وَرَبُّ آبَائِكُمُ الْأَوَّلِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_9",
      "surahNumber": 44,
      "ayahNumber": 9,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "بَلْ هُمْ فِي شَكٍّ يَلْعَبُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_10",
      "surahNumber": 44,
      "ayahNumber": 10,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "فَارْتَقِبْ يَوْمَ تَأْتِي السَّمَاءُ بِدُخَانٍ مُّبِينٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_11",
      "surahNumber": 44,
      "ayahNumber": 11,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "يَغْشَى النَّاسَ هَٰذَا عَذَابٌ أَلِيمٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_12",
      "surahNumber": 44,
      "ayahNumber": 12,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "رَّبَّنَا اكْشِفْ عَنَّا الْعَذَابَ إِنَّا مُؤْمِنُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_13",
      "surahNumber": 44,
      "ayahNumber": 13,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "أَنَّىٰ لَهُمُ الذِّكْرَىٰ وَقَدْ جَاءَهُمْ رَسُولٌ مُّبِينٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_14",
      "surahNumber": 44,
      "ayahNumber": 14,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "ثُمَّ تَوَلَّوْا عَنْهُ وَقَالُوا مُعَلَّمٌ مَّجْنُونٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_15",
      "surahNumber": 44,
      "ayahNumber": 15,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "إِنَّا كَاشِفُو الْعَذَابِ قَلِيلًا إِنَّكُمْ عَائِدُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_16",
      "surahNumber": 44,
      "ayahNumber": 16,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "يَوْمَ نَبْطِشُ الْبَطْشَةَ الْكُبْرَىٰ إِنَّا مُنتَقِمُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_17",
      "surahNumber": 44,
      "ayahNumber": 17,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَاءَهُمْ رَسُولٌ كَرِيمٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_18",
      "surahNumber": 44,
      "ayahNumber": 18,
      "juz": 25,
      "hizb": 50,
      "page": 496,
      "textArabic": "أَنْ أَدُّوا إِلَيَّ عِبَادَ اللَّهِ إِنِّي لَكُمْ رَسُولٌ أَمِينٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_19",
      "surahNumber": 44,
      "ayahNumber": 19,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَأَن لَّا تَعْلُوا عَلَى اللَّهِ إِنِّي آتِيكُم بِسُلْطَانٍ مُّبِينٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_20",
      "surahNumber": 44,
      "ayahNumber": 20,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَإِنِّي عُذْتُ بِرَبِّي وَرَبِّكُمْ أَن تَرْجُمُونِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_21",
      "surahNumber": 44,
      "ayahNumber": 21,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَإِن لَّمْ تُؤْمِنُوا لِي فَاعْتَزِلُونِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_22",
      "surahNumber": 44,
      "ayahNumber": 22,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "فَدَعَا رَبَّهُ أَنَّ هَٰؤُلَاءِ قَوْمٌ مُّجْرِمُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_23",
      "surahNumber": 44,
      "ayahNumber": 23,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "فَأَسْرِ بِعِبَادِي لَيْلًا إِنَّكُم مُّتَّبَعُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_24",
      "surahNumber": 44,
      "ayahNumber": 24,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَاتْرُكِ الْبَحْرَ رَهْوًا إِنَّهُمْ جُندٌ مُّغْرَقُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_25",
      "surahNumber": 44,
      "ayahNumber": 25,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "كَمْ تَرَكُوا مِن جَنَّاتٍ وَعُيُونٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_26",
      "surahNumber": 44,
      "ayahNumber": 26,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_27",
      "surahNumber": 44,
      "ayahNumber": 27,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَنَعْمَةٍ كَانُوا فِيهَا فَاكِهِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_28",
      "surahNumber": 44,
      "ayahNumber": 28,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "كَذَٰلِكَ وَأَوْرَثْنَاهَا قَوْمًا آخَرِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_29",
      "surahNumber": 44,
      "ayahNumber": 29,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "فَمَا بَكَتْ عَلَيْهِمُ السَّمَاءُ وَالْأَرْضُ وَمَا كَانُوا مُنظَرِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_30",
      "surahNumber": 44,
      "ayahNumber": 30,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَلَقَدْ نَجَّيْنَا بَنِي إِسْرَائِيلَ مِنَ الْعَذَابِ الْمُهِينِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_31",
      "surahNumber": 44,
      "ayahNumber": 31,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "مِن فِرْعَوْنَ إِنَّهُ كَانَ عَالِيًا مِّنَ الْمُسْرِفِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_32",
      "surahNumber": 44,
      "ayahNumber": 32,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَلَقَدِ اخْتَرْنَاهُمْ عَلَىٰ عِلْمٍ عَلَى الْعَالَمِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_33",
      "surahNumber": 44,
      "ayahNumber": 33,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَآتَيْنَاهُم مِّنَ الْآيَاتِ مَا فِيهِ بَلَاءٌ مُّبِينٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_34",
      "surahNumber": 44,
      "ayahNumber": 34,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "إِنَّ هَٰؤُلَاءِ لَيَقُولُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_35",
      "surahNumber": 44,
      "ayahNumber": 35,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "إِنْ هِيَ إِلَّا مَوْتَتُنَا الْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_36",
      "surahNumber": 44,
      "ayahNumber": 36,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "فَأْتُوا بِآبَائِنَا إِن كُنتُمْ صَادِقِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_37",
      "surahNumber": 44,
      "ayahNumber": 37,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍ وَالَّذِينَ مِن قَبْلِهِمْ أَهْلَكْنَاهُمْ إِنَّهُمْ كَانُوا مُجْرِمِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_38",
      "surahNumber": 44,
      "ayahNumber": 38,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "وَمَا خَلَقْنَا السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا لَاعِبِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_39",
      "surahNumber": 44,
      "ayahNumber": 39,
      "juz": 25,
      "hizb": 50,
      "page": 497,
      "textArabic": "مَا خَلَقْنَاهُمَا إِلَّا بِالْحَقِّ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "44_40",
      "surahNumber": 44,
      "ayahNumber": 40,
      "juz": 25,
      "hizb": 50,
      "page": 498,
