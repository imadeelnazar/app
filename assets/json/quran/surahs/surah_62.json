      "juz": 28,
      "hizb": 56,
      "page": 553,
      "textArabic": "ذَٰلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَن يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
