      "surahNumber": 43,
      "ayahNumber": 47,
      "juz": 25,
      "hizb": 50,
      "page": 492,
      "textArabic": "فَلَمَّا جَاءَهُم بِآيَاتِنَا إِذَا هُم مِّنْهَا يَضْحَكُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
