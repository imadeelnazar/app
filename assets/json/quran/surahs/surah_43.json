  "ayahs": [
    {
      "id": "43_1",
      "surahNumber": 43,
      "ayahNumber": 1,
      "juz": 25,
      "hizb": 49,
      "page": 489,
      "textArabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ حم",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
