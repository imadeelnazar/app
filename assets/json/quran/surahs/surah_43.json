      "surahNumber": 43,
      "ayahNumber": 67,
      "juz": 25,
      "hizb": 50,
      "page": 494,
      "textArabic": "الْأَخِلَّاءُ يَوْمَئِذٍ بَعْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا الْمُتَّقِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "43_68",
      "surahNumber": 43,
      "ayahNumber": 68,
      "juz": 25,
      "hizb": 50,
      "page": 494,
      "textArabic": "يَا عِبَادِ لَا خَوْفٌ عَلَيْكُمُ الْيَوْمَ وَلَا أَنتُمْ تَحْزَنُونَ",
