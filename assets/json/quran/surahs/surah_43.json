      "surahNumber": 43,
      "ayahNumber": 84,
      "juz": 25,
      "hizb": 50,
      "page": 495,
      "textArabic": "وَهُوَ الَّذِي فِي السَّمَاءِ إِلَٰهٌ وَفِي الْأَرْضِ إِلَٰهٌ وَهُوَ الْحَكِيمُ الْعَلِيمُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
