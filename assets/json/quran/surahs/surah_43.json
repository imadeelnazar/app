      "surahNumber": 43,
      "ayahNumber": 70,
      "juz": 25,
      "hizb": 50,
      "page": 494,
      "textArabic": "ادْخُلُوا الْجَنَّةَ أَنتُمْ وَأَزْوَاجُكُمْ تُحْبَرُونَ",
      "textEnglish": "",
      "textUrdu": "",
