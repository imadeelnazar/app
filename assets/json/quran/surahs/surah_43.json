      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "43_52",
      "surahNumber": 43,
      "ayahNumber": 52,
      "juz": 25,
      "hizb": 50,
      "page": 493,
      "textArabic": "أَمْ أَنَا خَيْرٌ مِّنْ هَٰذَا الَّذِي هُوَ مَهِينٌ وَلَا يَكَادُ يُبِينُ",
