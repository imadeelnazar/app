      "ayahNumber": 69,
      "juz": 25,
      "hizb": 50,
      "page": 494,
      "textArabic": "الَّذِينَ آمَنُوا بِآيَاتِنَا وَكَانُوا مُسْلِمِينَ",
      "textEnglish": "",
      "textUrdu": "",
