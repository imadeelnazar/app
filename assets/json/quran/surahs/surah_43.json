      "surahNumber": 43,
      "ayahNumber": 44,
      "juz": 25,
      "hizb": 50,
      "page": 492,
      "textArabic": "وَإِنَّهُ لَذِكْرٌ لَّكَ وَلِقَوْمِكَ وَسَوْفَ تُسْأَلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
