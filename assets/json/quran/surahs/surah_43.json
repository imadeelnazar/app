      "surahNumber": 43,
      "ayahNumber": 75,
      "juz": 25,
      "hizb": 50,
      "page": 495,
      "textArabic": "لَا يُفَتَّرُ عَنْهُمْ وَهُمْ فِيهِ مُبْلِسُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
