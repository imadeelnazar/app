      "surahNumber": 43,
      "ayahNumber": 79,
      "juz": 25,
      "hizb": 50,
      "page": 495,
      "textArabic": "أَمْ أَبْرَمُوا أَمْرًا فَإِنَّا مُبْرِمُونَ",
