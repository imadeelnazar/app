      "surahNumber": 43,
      "ayahNumber": 81,
      "juz": 25,
      "hizb": 50,
      "page": 495,
      "textArabic": "قُلْ إِن كَانَ لِلرَّحْمَٰنِ وَلَدٌ فَأَنَا أَوَّلُ الْعَابِدِينَ",
