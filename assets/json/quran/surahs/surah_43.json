      "surahNumber": 43,
      "ayahNumber": 56,
      "juz": 25,
      "hizb": 50,
      "page": 493,
      "textArabic": "فَجَعَلْنَاهُمْ سَلَفًا وَمَثَلًا لِّلْآخِرِينَ",
