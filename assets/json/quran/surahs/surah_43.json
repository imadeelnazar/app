      "surahNumber": 43,
      "ayahNumber": 38,
      "juz": 25,
      "hizb": 50,
      "page": 492,
      "textArabic": "حَتَّىٰ إِذَا جَاءَنَا قَالَ يَا لَيْتَ بَيْنِي وَبَيْنَكَ بُعْدَ الْمَشْرِقَيْنِ فَبِئْسَ الْقَرِينُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
