      "surahNumber": 43,
      "ayahNumber": 74,
      "juz": 25,
      "hizb": 50,
      "page": 495,
      "textArabic": "إِنَّ الْمُجْرِمِينَ فِي عَذَابِ جَهَنَّمَ خَالِدُونَ",
      "textEnglish": "",
