      "surahNumber": 43,
      "ayahNumber": 82,
      "juz": 25,
      "hizb": 50,
      "page": 495,
      "textArabic": "سُبْحَانَ رَبِّ السَّمَاوَاتِ وَالْأَرْضِ رَبِّ الْعَرْشِ عَمَّا يَصِفُونَ",
