      "surahNumber": 43,
      "ayahNumber": 76,
      "juz": 25,
      "hizb": 50,
      "page": 495,
      "textArabic": "وَمَا ظَلَمْنَاهُمْ وَلَٰكِن كَانُوا هُمُ الظَّالِمِينَ",
      "textEnglish": "",
      "textUrdu": "",
