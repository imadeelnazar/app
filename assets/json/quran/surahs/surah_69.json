      "surahNumber": 69,
      "ayahNumber": 6,
      "juz": 29,
      "hizb": 57,
      "page": 566,
      "textArabic": "وَأَمَّا عَادٌ فَأُهْلِكُوا بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_7",
      "surahNumber": 69,
      "ayahNumber": 7,
      "juz": 29,
      "hizb": 57,
      "page": 566,
      "textArabic": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَانِيَةَ أَيَّامٍ حُسُومًا فَتَرَى الْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_8",
      "surahNumber": 69,
      "ayahNumber": 8,
      "juz": 29,
      "hizb": 57,
      "page": 566,
      "textArabic": "فَهَلْ تَرَىٰ لَهُم مِّن بَاقِيَةٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_9",
      "surahNumber": 69,
      "ayahNumber": 9,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "وَجَاءَ فِرْعَوْنُ وَمَن قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_10",
      "surahNumber": 69,
      "ayahNumber": 10,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "فَعَصَوْا رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_11",
      "surahNumber": 69,
      "ayahNumber": 11,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "إِنَّا لَمَّا طَغَى الْمَاءُ حَمَلْنَاكُمْ فِي الْجَارِيَةِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_12",
      "surahNumber": 69,
      "ayahNumber": 12,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَا أُذُنٌ وَاعِيَةٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_13",
      "surahNumber": 69,
      "ayahNumber": 13,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "فَإِذَا نُفِخَ فِي الصُّورِ نَفْخَةٌ وَاحِدَةٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_14",
      "surahNumber": 69,
      "ayahNumber": 14,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "وَحُمِلَتِ الْأَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَاحِدَةً",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_15",
      "surahNumber": 69,
      "ayahNumber": 15,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "فَيَوْمَئِذٍ وَقَعَتِ الْوَاقِعَةُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_16",
      "surahNumber": 69,
      "ayahNumber": 16,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "وَانشَقَّتِ السَّمَاءُ فَهِيَ يَوْمَئِذٍ وَاهِيَةٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_17",
      "surahNumber": 69,
      "ayahNumber": 17,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "وَالْمَلَكُ عَلَىٰ أَرْجَائِهَا وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_18",
      "surahNumber": 69,
      "ayahNumber": 18,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_19",
      "surahNumber": 69,
      "ayahNumber": 19,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ فَيَقُولُ هَاؤُمُ اقْرَءُوا كِتَابِيَهْ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_20",
      "surahNumber": 69,
      "ayahNumber": 20,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "إِنِّي ظَنَنتُ أَنِّي مُلَاقٍ حِسَابِيَهْ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
