    {
      "id": "69_4",
      "surahNumber": 69,
      "ayahNumber": 4,
      "juz": 29,
      "hizb": 57,
      "page": 566,
      "textArabic": "كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ",
