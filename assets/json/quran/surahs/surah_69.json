      "surahNumber": 69,
      "ayahNumber": 32,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "ثُمَّ فِي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُ",
