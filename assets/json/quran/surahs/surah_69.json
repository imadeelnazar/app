      "surahNumber": 69,
      "ayahNumber": 33,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "إِنَّهُ كَانَ لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
