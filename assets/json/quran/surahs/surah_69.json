      "surahNumber": 69,
      "ayahNumber": 35,
      "juz": 29,
      "hizb": 57,
      "page": 568,
      "textArabic": "فَلَيْسَ لَهُ الْيَوْمَ هَاهُنَا حَمِيمٌ",
