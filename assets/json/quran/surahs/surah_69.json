      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_23",
      "surahNumber": 69,
      "ayahNumber": 23,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "قُطُوفُهَا دَانِيَةٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_24",
      "surahNumber": 69,
      "ayahNumber": 24,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا أَسْلَفْتُمْ فِي الْأَيَّامِ الْخَالِيَةِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
