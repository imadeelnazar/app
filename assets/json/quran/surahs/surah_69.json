      "surahNumber": 69,
      "ayahNumber": 34,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ",
