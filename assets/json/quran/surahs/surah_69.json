      "surahNumber": 69,
      "ayahNumber": 25,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِشِمَالِهِ فَيَقُولُ يَا لَيْتَنِي لَمْ أُوتَ كِتَابِيَهْ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_26",
      "surahNumber": 69,
      "ayahNumber": 26,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ",
