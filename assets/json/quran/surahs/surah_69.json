      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "69_5",
      "surahNumber": 69,
      "ayahNumber": 5,
      "juz": 29,
      "hizb": 57,
      "page": 566,
      "textArabic": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا بِالطَّاغِيَةِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
