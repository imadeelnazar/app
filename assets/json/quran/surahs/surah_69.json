      "surahNumber": 69,
      "ayahNumber": 21,
      "juz": 29,
      "hizb": 57,
      "page": 567,
      "textArabic": "فَهُوَ فِي عِيشَةٍ رَّاضِيَةٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
