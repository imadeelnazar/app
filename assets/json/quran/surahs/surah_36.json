      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "36_55",
      "surahNumber": 36,
      "ayahNumber": 55,
      "juz": 23,
      "hizb": 45,
      "page": 444,
      "textArabic": "إِنَّ أَصْحَابَ الْجَنَّةِ الْيَوْمَ فِي شُغُلٍ فَاكِهُونَ",
