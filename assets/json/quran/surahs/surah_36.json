      "surahNumber": 36,
      "ayahNumber": 42,
      "juz": 23,
      "hizb": 45,
      "page": 443,
      "textArabic": "وَخَلَقْنَا لَهُم مِّن مِّثْلِهِ مَا يَرْكَبُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
