      "surahNumber": 36,
      "ayahNumber": 44,
      "juz": 23,
      "hizb": 45,
      "page": 443,
      "textArabic": "إِلَّا رَحْمَةً مِّنَّا وَمَتَاعًا إِلَىٰ حِينٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
