    {
      "id": "36_3",
      "surahNumber": 36,
      "ayahNumber": 3,
      "juz": 22,
      "hizb": 44,
      "page": 440,
      "textArabic": "إِنَّكَ لَمِنَ الْمُرْسَلِينَ",
