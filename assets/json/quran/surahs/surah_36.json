      "surahNumber": 36,
      "ayahNumber": 57,
      "juz": 23,
      "hizb": 45,
      "page": 444,
      "textArabic": "لَهُمْ فِيهَا فَاكِهَةٌ وَلَهُم مَّا يَدَّعُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "36_58",
      "surahNumber": 36,
      "ayahNumber": 58,
      "juz": 23,
      "hizb": 45,
      "page": 444,
      "textArabic": "سَلَامٌ قَوْلًا مِّن رَّبٍّ رَّحِيمٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "36_59",
      "surahNumber": 36,
      "ayahNumber": 59,
      "juz": 23,
      "hizb": 45,
      "page": 444,
      "textArabic": "وَامْتَازُوا الْيَوْمَ أَيُّهَا الْمُجْرِمُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "36_60",
      "surahNumber": 36,
      "ayahNumber": 60,
      "juz": 23,
      "hizb": 45,
      "page": 444,
      "textArabic": "أَلَمْ أَعْهَدْ إِلَيْكُمْ يَا بَنِي آدَمَ أَن لَّا تَعْبُدُوا الشَّيْطَانَ إِنَّهُ لَكُمْ عَدُوٌّ مُّبِينٌ",
