      "surahNumber": 36,
      "ayahNumber": 38,
      "juz": 23,
      "hizb": 45,
      "page": 442,
      "textArabic": "وَالشَّمْسُ تَجْرِي لِمُسْتَقَرٍّ لَّهَا ذَٰلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
