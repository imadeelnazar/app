      "audioEndTime": null
    },
    {
      "id": "52_12",
      "surahNumber": 52,
      "ayahNumber": 12,
      "juz": 27,
      "hizb": 53,
      "page": 523,
      "textArabic": "الَّذِينَ هُمْ فِي خَوْضٍ يَلْعَبُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_13",
      "surahNumber": 52,
      "ayahNumber": 13,
      "juz": 27,
      "hizb": 53,
      "page": 523,
      "textArabic": "يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_14",
      "surahNumber": 52,
      "ayahNumber": 14,
      "juz": 27,
      "hizb": 53,
      "page": 523,
      "textArabic": "هَٰذِهِ النَّارُ الَّتِي كُنتُم بِهَا تُكَذِّبُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_15",
      "surahNumber": 52,
      "ayahNumber": 15,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "أَفَسِحْرٌ هَٰذَا أَمْ أَنتُمْ لَا تُبْصِرُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_16",
      "surahNumber": 52,
      "ayahNumber": 16,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "اصْلَوْهَا فَاصْبِرُوا أَوْ لَا تَصْبِرُوا سَوَاءٌ عَلَيْكُمْ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_17",
      "surahNumber": 52,
      "ayahNumber": 17,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَعِيمٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_18",
      "surahNumber": 52,
      "ayahNumber": 18,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "فَاكِهِينَ بِمَا آتَاهُمْ رَبُّهُمْ وَوَقَاهُمْ رَبُّهُمْ عَذَابَ الْجَحِيمِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_19",
      "surahNumber": 52,
      "ayahNumber": 19,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنتُمْ تَعْمَلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_20",
      "surahNumber": 52,
      "ayahNumber": 20,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "مُتَّكِئِينَ عَلَىٰ سُرُرٍ مَّصْفُوفَةٍ وَزَوَّجْنَاهُم بِحُورٍ عِينٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_21",
      "surahNumber": 52,
      "ayahNumber": 21,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "وَالَّذِينَ آمَنُوا وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَانٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَا أَلَتْنَاهُم مِّنْ عَمَلِهِم مِّن شَيْءٍ كُلُّ امْرِئٍ بِمَا كَسَبَ رَهِينٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_22",
      "surahNumber": 52,
      "ayahNumber": 22,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "وَأَمْدَدْنَاهُم بِفَاكِهَةٍ وَلَحْمٍ مِّمَّا يَشْتَهُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_23",
      "surahNumber": 52,
      "ayahNumber": 23,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "يَتَنَازَعُونَ فِيهَا كَأْسًا لَّا لَغْوٌ فِيهَا وَلَا تَأْثِيمٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_24",
      "surahNumber": 52,
      "ayahNumber": 24,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌ مَّكْنُونٌ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_25",
      "surahNumber": 52,
      "ayahNumber": 25,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_26",
      "surahNumber": 52,
      "ayahNumber": 26,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "قَالُوا إِنَّا كُنَّا قَبْلُ فِي أَهْلِنَا مُشْفِقِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_27",
      "surahNumber": 52,
      "ayahNumber": 27,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "فَمَنَّ اللَّهُ عَلَيْنَا وَوَقَانَا عَذَابَ السَّمُومِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_28",
      "surahNumber": 52,
      "ayahNumber": 28,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ إِنَّهُ هُوَ الْبَرُّ الرَّحِيمُ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_29",
      "surahNumber": 52,
      "ayahNumber": 29,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "فَذَكِّرْ فَمَا أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_30",
      "surahNumber": 52,
      "ayahNumber": 30,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "أَمْ يَقُولُونَ شَاعِرٌ نَّتَرَبَّصُ بِهِ رَيْبَ الْمَنُونِ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_31",
      "surahNumber": 52,
      "ayahNumber": 31,
      "juz": 27,
      "hizb": 53,
      "page": 524,
      "textArabic": "قُلْ تَرَبَّصُوا فَإِنِّي مَعَكُم مِّنَ الْمُتَرَبِّصِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_32",
      "surahNumber": 52,
      "ayahNumber": 32,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "أَمْ تَأْمُرُهُمْ أَحْلَامُهُم بِهَٰذَا أَمْ هُمْ قَوْمٌ طَاغُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_33",
      "surahNumber": 52,
      "ayahNumber": 33,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "أَمْ يَقُولُونَ تَقَوَّلَهُ بَل لَّا يُؤْمِنُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_34",
      "surahNumber": 52,
      "ayahNumber": 34,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "فَلْيَأْتُوا بِحَدِيثٍ مِّثْلِهِ إِن كَانُوا صَادِقِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_35",
      "surahNumber": 52,
      "ayahNumber": 35,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "أَمْ خُلِقُوا مِنْ غَيْرِ شَيْءٍ أَمْ هُمُ الْخَالِقُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_36",
      "surahNumber": 52,
      "ayahNumber": 36,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "أَمْ خَلَقُوا السَّمَاوَاتِ وَالْأَرْضَ بَل لَّا يُوقِنُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_37",
      "surahNumber": 52,
      "ayahNumber": 37,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "أَمْ عِندَهُمْ خَزَائِنُ رَبِّكَ أَمْ هُمُ الْمُصَيْطِرُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_38",
      "surahNumber": 52,
      "ayahNumber": 38,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "أَمْ لَهُمْ سُلَّمٌ يَسْتَمِعُونَ فِيهِ فَلْيَأْتِ مُسْتَمِعُهُم بِسُلْطَانٍ مُّبِينٍ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_39",
      "surahNumber": 52,
      "ayahNumber": 39,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "أَمْ لَهُ الْبَنَاتُ وَلَكُمُ الْبَنُونَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "52_40",
      "surahNumber": 52,
      "ayahNumber": 40,
      "juz": 27,
      "hizb": 53,
      "page": 525,
      "textArabic": "أَمْ تَسْأَلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ",
