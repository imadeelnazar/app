    {
      "id": "52_11",
      "surahNumber": 52,
      "ayahNumber": 11,
      "juz": 27,
      "hizb": 53,
      "page": 523,
      "textArabic": "فَوَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
