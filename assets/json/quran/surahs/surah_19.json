      "audioEndTime": null
    },
    {
      "id": "19_32",
      "surahNumber": 19,
      "ayahNumber": 32,
      "juz": 16,
      "hizb": 31,
      "page": 307,
      "textArabic": "وَبَرًّا بِوَالِدَتِي وَلَمْ يَجْعَلْنِي جَبَّارًا شَقِيًّا",
