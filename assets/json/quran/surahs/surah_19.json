      "audioEndTime": null
    },
    {
      "id": "19_28",
      "surahNumber": 19,
      "ayahNumber": 28,
      "juz": 16,
      "hizb": 31,
      "page": 307,
      "textArabic": "يَا أُخْتَ هَارُونَ مَا كَانَ أَبُوكِ امْرَأَ سَوْءٍ وَمَا كَانَتْ أُمُّكِ بَغِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_29",
      "surahNumber": 19,
      "ayahNumber": 29,
      "juz": 16,
      "hizb": 31,
      "page": 307,
      "textArabic": "فَأَشَارَتْ إِلَيْهِ قَالُوا كَيْفَ نُكَلِّمُ مَن كَانَ فِي الْمَهْدِ صَبِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_30",
      "surahNumber": 19,
      "ayahNumber": 30,
      "juz": 16,
      "hizb": 31,
      "page": 307,
      "textArabic": "قَالَ إِنِّي عَبْدُ اللَّهِ آتَانِيَ الْكِتَابَ وَجَعَلَنِي نَبِيًّا",
