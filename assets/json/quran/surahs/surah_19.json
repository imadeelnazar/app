      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_25",
      "surahNumber": 19,
      "ayahNumber": 25,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "وَهُزِّي إِلَيْكِ بِجِذْعِ النَّخْلَةِ تُسَاقِطْ عَلَيْكِ رُطَبًا جَنِيًّا",
