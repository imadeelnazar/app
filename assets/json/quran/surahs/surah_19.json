    },
    {
      "id": "19_20",
      "surahNumber": 19,
      "ayahNumber": 20,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "قَالَتْ أَنَّىٰ يَكُونُ لِي غُلَامٌ وَلَمْ يَمْسَسْنِي بَشَرٌ وَلَمْ أَكُ بَغِيًّا",
