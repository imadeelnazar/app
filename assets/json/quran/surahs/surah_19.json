    {
      "id": "19_3",
      "surahNumber": 19,
      "ayahNumber": 3,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "إِذْ نَادَىٰ رَبَّهُ نِدَاءً خَفِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
