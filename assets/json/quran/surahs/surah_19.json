      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_26",
      "surahNumber": 19,
      "ayahNumber": 26,
      "juz": 16,
      "hizb": 31,
      "page": 307,
      "textArabic": "فَكُلِي وَاشْرَبِي وَقَرِّي عَيْنًا فَإِمَّا تَرَيِنَّ مِنَ الْبَشَرِ أَحَدًا فَقُولِي إِنِّي نَذَرْتُ لِلرَّحْمَٰنِ صَوْمًا فَلَنْ أُكَلِّمَ الْيَوْمَ إِنسِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_27",
      "surahNumber": 19,
      "ayahNumber": 27,
      "juz": 16,
      "hizb": 31,
      "page": 307,
      "textArabic": "فَأَتَتْ بِهِ قَوْمَهَا تَحْمِلُهُ قَالُوا يَا مَرْيَمُ لَقَدْ جِئْتِ شَيْئًا فَرِيًّا",
