      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_35",
      "surahNumber": 19,
      "ayahNumber": 35,
      "juz": 16,
      "hizb": 31,
      "page": 307,
      "textArabic": "مَا كَانَ لِلَّهِ أَن يَتَّخِذَ مِن وَلَدٍ سُبْحَانَهُ إِذَا قَضَىٰ أَمْرًا فَإِنَّمَا يَقُولُ لَهُ كُن فَيَكُونُ",
