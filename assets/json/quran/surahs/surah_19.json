      "surahNumber": 19,
      "ayahNumber": 22,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "فَحَمَلَتْهُ فَانتَبَذَتْ بِهِ مَكَانًا قَصِيًّا",
      "textEnglish": "",
      "textUrdu": "",
