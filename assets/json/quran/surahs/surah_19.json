      "surahNumber": 19,
      "ayahNumber": 2,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "ذِكْرُ رَحْمَتِ رَبِّكَ عَبْدَهُ زَكَرِيَّا",
      "textEnglish": "",
      "textUrdu": "",
