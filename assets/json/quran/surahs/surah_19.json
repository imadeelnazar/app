      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_14",
      "surahNumber": 19,
      "ayahNumber": 14,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "وَبَرًّا بِوَالِدَيْهِ وَلَمْ يَكُن جَبَّارًا عَصِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_15",
      "surahNumber": 19,
      "ayahNumber": 15,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "وَسَلَامٌ عَلَيْهِ يَوْمَ وُلِدَ وَيَوْمَ يَمُوتُ وَيَوْمَ يُبْعَثُ حَيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_16",
      "surahNumber": 19,
      "ayahNumber": 16,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "وَاذْكُرْ فِي الْكِتَابِ مَرْيَمَ إِذِ انتَبَذَتْ مِنْ أَهْلِهَا مَكَانًا شَرْقِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_17",
      "surahNumber": 19,
      "ayahNumber": 17,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "فَاتَّخَذَتْ مِن دُونِهِمْ حِجَابًا فَأَرْسَلْنَا إِلَيْهَا رُوحَنَا فَتَمَثَّلَ لَهَا بَشَرًا سَوِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_18",
      "surahNumber": 19,
      "ayahNumber": 18,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "قَالَتْ إِنِّي أَعُوذُ بِالرَّحْمَٰنِ مِنكَ إِن كُنتَ تَقِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
