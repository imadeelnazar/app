    },
    {
      "id": "19_24",
      "surahNumber": 19,
      "ayahNumber": 24,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "فَنَادَاهَا مِن تَحْتِهَا أَلَّا تَحْزَنِي قَدْ جَعَلَ رَبُّكِ تَحْتَكِ سَرِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
