    },
    {
      "id": "19_4",
      "surahNumber": 19,
      "ayahNumber": 4,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "قَالَ رَبِّ إِنِّي وَهَنَ الْعَظْمُ مِنِّي وَاشْتَعَلَ الرَّأْسُ شَيْبًا وَلَمْ أَكُن بِدُعَائِكَ رَبِّ شَقِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_5",
      "surahNumber": 19,
      "ayahNumber": 5,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "وَإِنِّي خِفْتُ الْمَوَالِيَ مِن وَرَائِي وَكَانَتِ امْرَأَتِي عَاقِرًا فَهَبْ لِي مِن لَّدُنكَ وَلِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_6",
      "surahNumber": 19,
      "ayahNumber": 6,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "يَرِثُنِي وَيَرِثُ مِنْ آلِ يَعْقُوبَ وَاجْعَلْهُ رَبِّ رَضِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_7",
      "surahNumber": 19,
      "ayahNumber": 7,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "يَا زَكَرِيَّا إِنَّا نُبَشِّرُكَ بِغُلَامٍ اسْمُهُ يَحْيَىٰ لَمْ نَجْعَل لَّهُ مِن قَبْلُ سَمِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_8",
      "surahNumber": 19,
      "ayahNumber": 8,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "قَالَ رَبِّ أَنَّىٰ يَكُونُ لِي غُلَامٌ وَكَانَتِ امْرَأَتِي عَاقِرًا وَقَدْ بَلَغْتُ مِنَ الْكِبَرِ عِتِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_9",
      "surahNumber": 19,
      "ayahNumber": 9,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "قَالَ كَذَٰلِكَ قَالَ رَبُّكَ هُوَ عَلَيَّ هَيِّنٌ وَقَدْ خَلَقْتُكَ مِن قَبْلُ وَلَمْ تَكُ شَيْئًا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_10",
      "surahNumber": 19,
      "ayahNumber": 10,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "قَالَ رَبِّ اجْعَل لِّي آيَةً قَالَ آيَتُكَ أَلَّا تُكَلِّمَ النَّاسَ ثَلَاثَ لَيَالٍ سَوِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_11",
      "surahNumber": 19,
      "ayahNumber": 11,
      "juz": 16,
      "hizb": 31,
      "page": 305,
      "textArabic": "فَخَرَجَ عَلَىٰ قَوْمِهِ مِنَ الْمِحْرَابِ فَأَوْحَىٰ إِلَيْهِمْ أَن سَبِّحُوا بُكْرَةً وَعَشِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_12",
      "surahNumber": 19,
      "ayahNumber": 12,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "يَا يَحْيَىٰ خُذِ الْكِتَابَ بِقُوَّةٍ وَآتَيْنَاهُ الْحُكْمَ صَبِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
      "audioUrl": "",
      "audioStartTime": null,
      "audioEndTime": null
    },
    {
      "id": "19_13",
      "surahNumber": 19,
      "ayahNumber": 13,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "وَحَنَانًا مِّن لَّدُنَّا وَزَكَاةً وَكَانَ تَقِيًّا",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
      "transliteration": "",
