    },
    {
      "id": "19_23",
      "surahNumber": 19,
      "ayahNumber": 23,
      "juz": 16,
      "hizb": 31,
      "page": 306,
      "textArabic": "فَأَجَاءَهَا الْمَخَاضُ إِلَىٰ جِذْعِ النَّخْلَةِ قَالَتْ يَا لَيْتَنِي مِتُّ قَبْلَ هَٰذَا وَكُنتُ نَسْيًا مَّنسِيًّا",
