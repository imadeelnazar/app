    },
    {
      "id": "19_31",
      "surahNumber": 19,
      "ayahNumber": 31,
      "juz": 16,
      "hizb": 31,
      "page": 307,
      "textArabic": "وَجَعَلَنِي مُبَارَكًا أَيْنَ مَا كُنتُ وَأَوْصَانِي بِالصَّلَاةِ وَالزَّكَاةِ مَا دُمْتُ حَيًّا",
