    {
      "id": "53_23",
      "surahNumber": 53,
      "ayahNumber": 23,
      "juz": 27,
      "hizb": 53,
      "page": 526,
      "textArabic": "إِنْ هِيَ إِلَّا أَسْمَاءٌ سَمَّيْتُمُوهَا أَنتُمْ وَآبَاؤُكُم مَّا أَنزَلَ اللَّهُ بِهَا مِن سُلْطَانٍ إِن يَتَّبِعُونَ إِلَّا الظَّنَّ وَمَا تَهْوَى الْأَنفُسُ وَلَقَدْ جَاءَهُم مِّن رَّبِّهِمُ الْهُدَىٰ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
