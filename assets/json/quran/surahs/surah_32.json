    {
      "id": "32_2",
      "surahNumber": 32,
      "ayahNumber": 2,
      "juz": 21,
      "hizb": 42,
      "page": 415,
      "textArabic": "تَنزِيلُ الْكِتَابِ لَا رَيْبَ فِيهِ مِن رَّبِّ الْعَالَمِينَ",
      "textEnglish": "",
      "textUrdu": "",
      "textFarsi": "",
